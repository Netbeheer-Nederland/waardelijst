<https://modellen.netbeheernederland.nl/codes/netbeheerder/shacl> a owl:Ontology ;
    owl:versionInfo "1.0" ;
    rdfs:seeAlso <https://modellen.netbeheernederland.nl/codes/netbeheerder> .
    
:netbeheerderShape a sh:NodeShape ;
